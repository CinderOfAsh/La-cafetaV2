// La Cafeta — Schema completo (v2)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String   @default("")
  role         String   @default("EMPLOYEE") // ADMIN | EMPLOYEE | COCINERO | CAMARERO
  isActive     Boolean  @default(true)
  customFields String   @default("{}") // JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedShifts    ShiftAssignment[]
  saleTransactions  SaleTransaction[]
  originalSwaps     ShiftSwap[]       @relation("OriginalUser")
  replacementSwaps  ShiftSwap[]       @relation("ReplacementUser")
}

model Product {
  id           String   @id @default(cuid())
  name         String
  price        Float
  tags         String   @default("[]") // JSON string array
  imageUrl     String?
  description  String?
  isActive     Boolean  @default(true)
  customFields String   @default("{}") // JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  protocol   Protocol?
  saleItems  SaleItem[]
  recipes    ProductRecipe[]
}

model RawMaterial {
  id              String           @id @default(cuid())
  name            String
  unit            String           @default("ud") // ud, kg, g, L, ml, plato, servilleta...
  stock           Float            @default(0)
  minStock        Float            @default(0)
  lastPurchasedAt DateTime?        // cuando se compró por última vez desde Lista de la Compra
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  recipes   ProductRecipe[]
  purchases PurchaseItem[]
}

// Receta: qué materias primas y en qué cantidad componen un producto
model ProductRecipe {
  id            String  @id @default(cuid())
  productId     String
  rawMaterialId String
  quantity      Float   @default(1) // cantidad de esa materia prima por unidad de producto

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@unique([productId, rawMaterialId])
}

// Compra / abastecimiento de materias primas
model Purchase {
  id            String           @id @default(cuid())
  date          DateTime         @default(now())
  supplier      String?          // proveedor opcional
  notes         String?
  totalAmount   Float            @default(0) // suma calculada de los items
  invoiceUrl    String?          // URL del archivo de factura subido
  conciliatedAt DateTime?        // null = no conciliado, fecha = conciliado
  source        String           @default("manual") // "manual" (registro directo) | "shopping-list" (desde lista de la compra)
  createdAt     DateTime         @default(now())

  items       PurchaseItem[]
}

model PurchaseItem {
  id            String   @id @default(cuid())
  purchaseId    String
  rawMaterialId String
  quantity      Float    @default(0)
  unitPrice     Float    @default(0) // precio unitario
  subtotal      Float    @default(0) // quantity * unitPrice

  purchase    Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
}

model Shift {
  id              String   @id @default(cuid())
  name            String
  startTime       String   // "HH:mm"
  endTime         String   // "HH:mm"
  daysOfWeek      String   @default("0,1,2,3,4,5,6") // CSV 0..6
  openingProtocol String   @default("[]") // JSON string array de pasos
  closingProtocol String   @default("[]") // JSON string array de pasos
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments ShiftAssignment[]
}

model ShiftAssignment {
  id        String   @id @default(cuid())
  shiftId   String
  userId    String
  date      String   // "YYYY-MM-DD"
  role      String   @default("CAMARERO") // CAMARERO | COCINERO
  createdAt DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalSwaps    ShiftSwap[] @relation("OriginalAssignment")
  replacementSwaps ShiftSwap[] @relation("ReplacementAssignment")
}

model ShiftSwap {
  id                  String    @id @default(cuid())
  originalUserId      String
  replacementUserId   String
  shiftAssignmentId   String
  type                String    @default("swap") // swap | substitute
  status              String    @default("PENDING") // PENDING | APPROVED | REJECTED
  // For "swap" type: the replacement's assignment to exchange with
  replacementShiftAssignmentId String?
  seenByOriginal      Boolean   @default(false)
  seenByReplacement   Boolean   @default(false)
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())

  originalUser     User            @relation("OriginalUser", fields: [originalUserId], references: [id])
  replacementUser  User            @relation("ReplacementUser", fields: [replacementUserId], references: [id])
  shiftAssignment              ShiftAssignment  @relation("OriginalAssignment", fields: [shiftAssignmentId], references: [id], onDelete: Cascade)
  replacementShiftAssignment   ShiftAssignment? @relation("ReplacementAssignment", fields: [replacementShiftAssignmentId], references: [id], onDelete: SetNull)
}

model SaleTransaction {
  id            String   @id @default(cuid())
  turnoId       Int      @default(1)
  employeeId    String?
  total         Float    @default(0)
  paymentMethod String   @default("cash") // cash | card
  createdAt     DateTime @default(now())

  employee User?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  items    SaleItem[]
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String?
  productName String
  price       Float
  quantity    Int      @default(1)
  priority    Int      @default(0)
  status      String   @default("PENDING") // PENDING | DELIVERED
  createdAt   DateTime @default(now())

  sale    SaleTransaction @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Protocol {
  id          String   @id @default(cuid())
  type        String   // APERTURA | CIERRE | COCINA | PRODUCTO
  name        String
  description String?
  steps       String   @default("[]") // JSON string array
  productId   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  completions ProtocolCompletion[]
}

model ProtocolCompletion {
  id          String   @id @default(cuid())
  protocolId  String
  date        String   // "YYYY-MM-DD"
  completedBy String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  protocol Protocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
}
